# Copy this file to .env and fill in the values for the tools you're using.
# Any connector left unconfigured is automatically skipped (not treated as an error).

# --- Splunk ---
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089
SPLUNK_TOKEN=your-splunk-auth-token
SPLUNK_VERIFY_SSL=true

# --- AWS CloudWatch --- (uses the standard AWS credential chain)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=my-profile   # alternative to access key/secret

# --- Prometheus ---
PROMETHEUS_URL=http://prometheus.example.com:9090

# --- Datadog ---
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# --- Optional: LLM-refined RCA narrative ---
# If unset, the agent still produces a full rule-based RCA -- this just
# rewrites the root-cause section in more natural language.
ANTHROPIC_API_KEY=
